{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anydevice.local/report-v2.schema.json",
  "title": "AnyDevice evidence report 2.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "appVersion",
    "collectedAt",
    "os",
    "complete",
    "sanitized",
    "devices",
    "findings",
    "errors",
    "limitations",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "appVersion": {
      "const": "0.2.0"
    },
    "collectedAt": {
      "type": "string"
    },
    "os": {
      "type": [
        "string",
        "null"
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "sanitized": {
      "type": "boolean"
    },
    "devices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/device"
      }
    },
    "previous": {
      "type": "object",
      "required": [
        "collectedAt",
        "devices",
        "provenance",
        "complete"
      ],
      "properties": {
        "collectedAt": {
          "type": "string"
        },
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/device"
          }
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "complete": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "message"
        ],
        "properties": {
          "kind": {
            "enum": [
              "permission",
              "property",
              "enumeration",
              "malformed"
            ]
          },
          "message": {
            "type": "string"
          },
          "deviceId": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "device": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "manufacturer",
        "hardwareIds",
        "parent",
        "location",
        "status",
        "problemCode",
        "vid",
        "pid",
        "transport",
        "observedAt",
        "source",
        "nodeKind",
        "physicalDeviceId",
        "interfacePaths",
        "present"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "manufacturer": {
          "type": [
            "string",
            "null"
          ]
        },
        "hardwareIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "problemCode": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "vid": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9A-F]{4}$"
        },
        "pid": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9A-F]{4}$"
        },
        "transport": {
          "enum": [
            "USB",
            "HID (transport unknown)",
            "Unknown"
          ]
        },
        "observedAt": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "nodeKind": {
          "const": "logical-pnp-node"
        },
        "physicalDeviceId": {
          "type": "null"
        },
        "interfacePaths": {
          "type": "array",
          "maxItems": 0
        },
        "present": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "containerId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "compatibleIds": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string"
          }
        },
        "locationPaths": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string"
          }
        },
        "deviceCapabilities": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4294967295
        },
        "removalPolicy": {
          "enum": [
            null,
            1,
            2,
            3
          ]
        },
        "enumeratorName": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8192
        }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "title",
        "severity",
        "classification",
        "confidence",
        "facts",
        "explanation",
        "evidence",
        "recommendation",
        "limitations"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "deviceId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "classification": {
          "enum": [
            "Windows-reported error",
            "Confirmed observation"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "limited"
          ]
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "explanation": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recommendation": {
          "type": "string"
        },
        "limitations": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "provider",
        "providerVersion",
        "scope"
      ],
      "properties": {
        "provider": {
          "enum": [
            "windows-cfgmgr32",
            "windows-pnp-fallback"
          ]
        },
        "providerVersion": {
          "const": "1.0"
        },
        "scope": {
          "enum": [
            "usb-hid",
            "all-pnp"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
